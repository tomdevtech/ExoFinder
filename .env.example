# Copy to .env.local. The values match the database from docker-compose.yml.
DATABASE_URL=postgres://exofinder:exofinder@localhost:5432/exofinder

# Optional. The databases of `npm run test:db` and `npm run test:e2e`. They are
# emptied on every run, so their names must end in _test or _e2e. Defaults:
# exofinder_test and exofinder_e2e on the database from docker-compose.yml.
TEST_DATABASE_URL=
E2E_DATABASE_URL=

# Optional, for hosting online (see docs/DEPLOYMENT.md). Locally none is needed.
# Connections per running instance, 5 by default.
DATABASE_POOL_SIZE=
# "false" turns prepared statements off. Needed behind a pooler in transaction
# mode that does not support them.
DATABASE_PREPARE=
# A direct address that bypasses the pooler. Migrations on deploy use it.
DATABASE_URL_UNPOOLED=
# The address of a role that may only read (npm run db:readonly-role). Only the
# website inside Next.js uses it; scripts and tests always take DATABASE_URL.
DATABASE_URL_READONLY=
# "true" also migrates preview deployments. Only with a database of their own.
DATABASE_MIGRATE_ON_BUILD=

# Optional. The folder the printed catalogue is downloaded from (npm run
# catalogue). Defaults to the release that catalogue.yml fills.
CATALOGUE_URL=

# Who runs this copy, for the legal notice and the privacy policy
# (/legal/notice, /legal/privacy). Read when the app is built. As long as one
# of the first four is missing, both pages say that they are not complete.
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
# Optional. The country defaults to Germany.
LEGAL_COUNTRY=
LEGAL_PHONE=
# For the privacy policy, needed as soon as the site runs at a hosting company:
# its name and address, and after how many days the server deletes its log
# entries (optional).
LEGAL_HOSTING=
LEGAL_LOG_DAYS=
# "true" only if a data processing agreement (Art. 28 GDPR) with the hosting
# company exists, for example on Vercel Pro. Vercel Hobby has none: leave empty.
LEGAL_HOSTING_DPA=
# Optional: one or two sentences on why the hosting company may process the
# data outside the EU, for example under which framework or contract clauses.
# Only shown together with LEGAL_HOSTING.
LEGAL_HOSTING_TRANSFER=
# Optional: name and address of the company that receives your e-mails (for
# example your mail provider). If it is outside the EU, say so in the text.
LEGAL_EMAIL_PROVIDER=
